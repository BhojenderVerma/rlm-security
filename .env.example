# ─── RLM Security Analysis System — Environment Variables ───────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ── Google Gemini API (for LLM-enhanced analysis) ──────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── GitHub Integration ─────────────────────────────────────────────────────
# Required for: scanning private repos, creating GitHub Issues
GITHUB_TOKEN=your_github_personal_access_token_here

# ── Scan Defaults (optional) ───────────────────────────────────────────────
RLM_MAX_WORKERS=8
RLM_OUTPUT_DIR=./reports
RLM_MIN_SEVERITY=MEDIUM
